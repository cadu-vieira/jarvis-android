<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#05070A">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="J A R V I S"
        android:textColor="#00E5FF"
        android:textSize="28sp"
        android:gravity="center"
        android:letterSpacing="0.18"
        android:padding="8dp"/>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sistema pronto."
        android:textColor="#B8C7D1"
        android:textSize="15sp"
        android:gravity="center"
        android:padding="10dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            android:id="@+id/conversation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E8F7FF"
            android:textSize="16sp"
            android:padding="12dp"/>
    </ScrollView>

    <EditText
        android:id="@+id/input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Digite um comando..."
        android:textColor="#FFFFFF"
        android:textColorHint="#78909C"
        android:backgroundTint="#00E5FF"
        android:singleLine="true"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/send"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ENVIAR"/>

        <Button
            android:id="@+id/mic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="OUVIR"/>
    </LinearLayout>

    <Button
        android:id="@+id/backgroundVoice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ATIVAR VOZ EM SEGUNDO PLANO"/>
</LinearLayout>
